# 复制为 .env 后填写真实的 DeepSeek API Key；留空则使用本地规则回答。
DEEPSEEK_API_KEY=sk-your-real-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务监听与端口。
# 本地开发保持 127.0.0.1；容器/服务器部署改为 0.0.0.0 才能被外部访问。
LICHENG_HOST=127.0.0.1
LICHENG_PORT=8787
# 云平台注入 PORT 时 run.py 会自动使用（LICHENG_PORT 优先级更高）。
# PORT=8080

# 数据库与上传目录路径（默认 ./data）。
# LICHENG_DB=./data/app.db

# 安全 Cookie：仅在全站启用 HTTPS 后设为 1，否则登录态会失效。
# LICHENG_SECURE_COOKIE=1

# 演示账号：生产部署务必设为 0，并自行注册管理员账号。
# LICHENG_DEMO_MODE=0
