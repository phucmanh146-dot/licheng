<view class="page"><view class="brand"><view class="brand-mark">鸭</view><view><view class="brand-name">上岸鸭</view><text class="brand-sub">账号安全中心</text></view></view><view class="eyebrow">ACCOUNT RECOVERY</view><view class="title">重置登录密码</view><view class="desc">先通过短信确认手机号归属，再设置新密码。</view>
 <view class="field"><text class="field-label">手机号</text><view class="input-wrap"><text class="prefix">+86</text><input class="input" type="number" maxlength="11" placeholder="请输入注册手机号" value="{{phone}}" bindinput="onPhone"/></view></view>
 <view class="field"><text class="field-label">短信验证码</text><view class="code-wrap"><view class="input-wrap"><input class="input" type="number" maxlength="6" placeholder="输入6位验证码" value="{{code}}" bindinput="onCode"/></view><button class="code-btn" bindtap="sendCode" disabled="{{sending||countdown>0}}">{{countdown>0?countdown+'秒后重发':'获取验证码'}}</button></view></view>
 <view class="primary" bindtap="verify" wx:if="{{!verified}}">验证手机号</view>
 <block wx:if="{{verified}}"><view class="field"><text class="field-label">新密码</text><view class="input-wrap"><input class="input" password placeholder="至少8位，包含字母和数字" value="{{password}}" bindinput="onPassword"/></view></view><view class="field"><text class="field-label">确认新密码</text><view class="input-wrap"><input class="input" password placeholder="再次输入新密码" value="{{confirm}}" bindinput="onConfirm"/></view></view><view class="primary" bindtap="save">保存新密码</view></block>
</view>